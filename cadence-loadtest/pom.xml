<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cadence</groupId>
        <artifactId>cadence-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>cadence-loadtest</artifactId>
    <name>cadence-loadtest</name>
    <description>Gatling load test against a running stack (spec 9 Phase 3, D99). `./mvnw verify` only compiles it;
        run it with `make loadtest`.</description>

    <!-- Gatling 3.16 runs on Netty 4.2; the Spring Boot BOM in the parent pins 4.1 for the apps (D99) -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>4.2.18.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.gatling.highcharts</groupId>
            <artifactId>gatling-charts-highcharts</artifactId>
            <version>${gatling.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.gatling</groupId>
                <artifactId>gatling-maven-plugin</artifactId>
                <version>${gatling-maven-plugin.version}</version>
                <configuration>
                    <simulationClass>com.cadence.loadtest.ListenerSimulation</simulationClass>
                    <runDescription>500 concurrent listeners</runDescription>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
