# direnv: `brew install direnv`, hook it into your shell, then `direnv allow`.
# Puts JDK 21 on the PATH for this repo (Maven also selects JDK 21 via toolchains; see DECISIONS.md D19).
JDK21=$(./scripts/setup-toolchains.sh --print)
export JAVA_HOME="$JDK21"
PATH_add "$JAVA_HOME/bin"
dotenv_if_exists .env
