# Copy to .env (git-ignored): `cp .env.example .env` — `make up` does this if .env is missing.
# Read by docker compose AND by the Spring apps (spring.config.import of .env). Dev-only values; change them.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=cadence
POSTGRES_USER=cadence
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
# JDBC URL used by cadence-api
CADENCE_DB_URL=jdbc:postgresql://localhost:5432/cadence

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# --- Kafka --------------------------------------------------------------------
KAFKA_PORT=9092
# Host apps use localhost:9092; containers on cadence-net use kafka:29092
CADENCE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CADENCE_KAFKA_PARTITIONS=3
CADENCE_KAFKA_REPLICATION_FACTOR=1
KAFKA_UI_PORT=8090

# --- MinIO (S3) ---------------------------------------------------------------
MINIO_ROOT_USER=cadence
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
CADENCE_S3_RAW_BUCKET=cadence-raw
CADENCE_S3_HLS_BUCKET=cadence-hls

# --- Apps ---------------------------------------------------------------------
CADENCE_API_PORT=8080
CADENCE_TRANSCODER_PORT=8081
# How often the transactional outbox is polled (Spring Duration)
CADENCE_OUTBOX_POLL_INTERVAL=500ms
