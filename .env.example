# Copy to .env (git-ignored): `cp .env.example .env` — `make up` does this if .env is missing.
# Read by docker compose AND by the Spring apps (spring.config.import of .env). Dev-only values; change them.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=cadence
POSTGRES_USER=cadence
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
# JDBC URL used by cadence-api
CADENCE_DB_URL=jdbc:postgresql://localhost:5432/cadence

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# --- Kafka --------------------------------------------------------------------
KAFKA_PORT=9092
# Host apps use localhost:9092; containers on cadence-net use kafka:29092
CADENCE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CADENCE_KAFKA_PARTITIONS=3
CADENCE_KAFKA_REPLICATION_FACTOR=1
KAFKA_UI_PORT=8090

# --- MinIO (S3) ---------------------------------------------------------------
MINIO_ROOT_USER=cadence
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
CADENCE_S3_RAW_BUCKET=cadence-raw
CADENCE_S3_HLS_BUCKET=cadence-hls
# Least-privilege app credentials, created by minio-init (readwrite on the two buckets only)
CADENCE_S3_ACCESS_KEY=cadence-app
CADENCE_S3_SECRET_KEY=change-me-app-secret
CADENCE_S3_ENDPOINT=http://localhost:9000
# Embedded in presigned URLs; must be reachable from the browser
CADENCE_S3_PUBLIC_ENDPOINT=http://localhost:9000
CADENCE_S3_REGION=us-east-1

# --- Elasticsearch (search) -----------------------------------------------------
# Password of the built-in "elastic" user (Compose sets it; the API logs in with it)
ELASTIC_PASSWORD=change-me-elastic
ELASTICSEARCH_PORT=9200
# Host apps use localhost:9200; the api container uses elasticsearch:9200
CADENCE_ELASTICSEARCH_URIS=http://localhost:9200
CADENCE_ELASTICSEARCH_USERNAME=elastic
# Index names are <prefix>-artists, -albums, -tracks, -playlists
CADENCE_SEARCH_INDEX_PREFIX=cadence

# --- Identity -----------------------------------------------------------------
# RS256 key pair from `make keys` (scripts/generate-dev-keys.sh). Paths are relative to the repo root.
CADENCE_JWT_PRIVATE_KEY_LOCATION=file:secrets/jwt-private.pem
CADENCE_JWT_PUBLIC_KEY_LOCATION=file:secrets/jwt-public.pem
CADENCE_JWT_ISSUER=cadence
# Admin created at API startup if this email is not registered yet (min 10 chars password)
CADENCE_ADMIN_EMAIL=admin@cadence.local
CADENCE_ADMIN_PASSWORD=change-me-admin-password
# Demo listener created by `make seed`
CADENCE_DEMO_EMAIL=demo@cadence.local
CADENCE_DEMO_PASSWORD=change-me-demo-password
# Redis host for the API (password: REDIS_PASSWORD above)
REDIS_HOST=localhost

# --- Apps ---------------------------------------------------------------------
CADENCE_API_PORT=8080
CADENCE_TRANSCODER_PORT=8081
# How often the transactional outbox is polled (Spring Duration)
CADENCE_OUTBOX_POLL_INTERVAL=500ms
